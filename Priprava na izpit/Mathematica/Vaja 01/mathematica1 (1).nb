Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Alpha]", "=", 
   RowBox[{"1830", "\[Degree]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Beta]", "=", 
   RowBox[{"270", "\[Degree]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Sin", "[", "\[Alpha]", "]"}], "+", 
    RowBox[{"Sin", "[", "\[Beta]", "]"}]}], ")"}], "/", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Cos", "[", 
       RowBox[{"\[Alpha]", "-", "\[Beta]"}], "]"}], ")"}], "^", "2"}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Sin", "[", 
       RowBox[{"\[Beta]", "-", "\[Alpha]"}], "]"}], ")"}], "^", "2"}]}], 
   ")"}]}]}], "Input",
 CellChangeTimes->{
