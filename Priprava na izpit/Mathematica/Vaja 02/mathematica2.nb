}], "Subsection",
 CellChangeTimes->{{3.784103806145114*^9, 3.784103811348242*^9}, {
  3.7841091227701435`*^9, 3.7841091228326087`*^9}, {3.90913974700583*^9, 
  3.909139754145627*^9}},ExpressionUUID->"5927276d-a418-4a49-ab4f-\
2459fdb4af57"],

Cell["\<\
Sin je 3 leta starej\[SHacek]i od h\[CHacek]ere, mati pa je 23 let starej\
\[SHacek]a od sina. Pred 6 leti je imela mati 4 krat toliko let kot sin in h\
\[CHacek]i skupaj. Koliko je star vsak od njih? Napi\[SHacek]ite \
ena\[CHacek]be in jih re\[SHacek]ite s pomo\[CHacek]jo funkcije Solve.\
\>", "Text",
 CellChangeTimes->{{3.628184823533084*^9, 3.6281849123146567`*^9}, {
   3.6282118853239956`*^9, 3.6282119048396587`*^9}, 3.7840899776153584`*^9, 
   3.7841038143482413`*^9, {3.9434450886022167`*^9, 
   3.943445101628008*^9}},ExpressionUUID->"d833d40b-1d33-44aa-b458-\
2a1d78b60fb3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"s", ",", "h", ",", "m"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "==", 
      RowBox[{"h", "+", "3"}]}], ",", 
     RowBox[{"m", "==", 
      RowBox[{"s", "+", "23"}]}], ",", 
     RowBox[{
      RowBox[{"m", "-", "6"}], "==", 
      RowBox[{"4", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"s", "-", "6"}], ")"}], "+", 
         RowBox[{"(", 
          RowBox[{"h", "-", "6"}], ")"}]}], ")"}]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"s", ",", "h", ",", "m"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.97842890284013*^9, 3.9784290597042274`*^9}, {
  3.978429116865986*^9, 3.978429269509836*^9}, {3.978429352023924*^9, 
  3.978429353243883*^9}, {3.978429406846773*^9, 3.97842941538513*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"1f357341-be0f-0745-a6a7-2cdfdf654f59"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"s", "\[Rule]", "11"}], ",", 
    RowBox[{"h", "\[Rule]", "8"}], ",", 
    RowBox[{"m", "\[Rule]", "34"}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{
  3.9784290608743496`*^9, 3.9784291775601883`*^9, {3.9784292132504025`*^9, 
