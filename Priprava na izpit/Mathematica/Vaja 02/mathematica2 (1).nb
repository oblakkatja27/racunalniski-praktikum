2459fdb4af57"],

Cell["\<\
Sin je 3 leta starej\[SHacek]i od h\[CHacek]ere, mati pa je 23 let starej\
\[SHacek]a od sina. Pred 6 leti je imela mati 4 krat toliko let kot sin in h\
\[CHacek]i skupaj. Koliko je star vsak od njih? Napi\[SHacek]ite \
ena\[CHacek]be in jih re\[SHacek]ite s pomo\[CHacek]jo funkcije Solve.\
\>", "Text",
 CellChangeTimes->{{3.628184823533084*^9, 3.6281849123146567`*^9}, {
   3.6282118853239956`*^9, 3.6282119048396587`*^9}, 3.7840899776153584`*^9, 
   3.7841038143482413`*^9, {3.9434450886022167`*^9, 
   3.943445101628008*^9}},ExpressionUUID->"d833d40b-1d33-44aa-b458-\
2a1d78b60fb3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"s", ",", "m", ",", "h", ",", "x", ",", "y"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"s", "==", 
      RowBox[{"h", "+", "3"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"m", "==", 
      RowBox[{"s", "+", "23"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"m", "-", "6"}], "==", 
      RowBox[{"4", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"s", "-", "6"}], ")"}], "+", 
         RowBox[{"(", 
          RowBox[{"h", "-", "6"}], ")"}]}], ")"}]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"s", ",", "h", ",", "m"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.979558167546732*^9, 3.979558308917204*^9}},
 CellLabel->
  "In[136]:=",ExpressionUUID->"7d3a5db6-5d7e-554d-be61-c481c6a01caa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"s", "\[Rule]", "11"}], ",", 
    RowBox[{"h", "\[Rule]", "8"}], ",", 
    RowBox[{"m", "\[Rule]", "34"}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.979558310639887*^9},
 CellLabel->
  "Out[137]=",ExpressionUUID->"82ea81bf-ceff-3446-a3f5-625956336f9b"]
}, Open  ]]
