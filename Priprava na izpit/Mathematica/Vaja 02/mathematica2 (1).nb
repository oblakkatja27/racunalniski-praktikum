 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"3", "==", 
      RowBox[{
       RowBox[{"k", "*", 
        RowBox[{"(", 
         RowBox[{"-", "2"}], ")"}]}], "+", "n"}]}], ",", 
     RowBox[{
      RowBox[{"-", "1"}], "==", 
      RowBox[{
