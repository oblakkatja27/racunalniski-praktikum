     RowBox[{
      RowBox[{"2", 
       SqrtBox[
        RowBox[{"\[Pi]", " ", "x"}]]}], "-", "\[Pi]", "-", "x"}]]}], 
   TraditionalForm]],ExpressionUUID->"270b6a20-a683-4d5d-b34e-77077063fed1"],
 "\n3. Izra\[CHacek]unajte levo limito:  ",
