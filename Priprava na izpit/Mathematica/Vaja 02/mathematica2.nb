Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"k", "\[Rule]", 
     RowBox[{"-", 
      FractionBox["1", "2"]}]}], ",", 
    RowBox[{"n", "\[Rule]", "2"}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.978430508517004*^9},
