Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"x", ",", "x0", ",", "f"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", " ", 
        RowBox[{"(", 
         RowBox[{"x", "-", "2"}], ")"}]}], ")"}], "^", "2"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", "^", "2"}], "+", "1"}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"y0", ",", "m", ",", "tang"}], "}"}], ",", 
     RowBox[{
      RowBox[{"y0", "=", 
       RowBox[{"f", "[", "x0", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"m", "=", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"f", "[", "x", "]"}], ",", "x"}], "]"}], "/.", " ", 
        RowBox[{"x", "->", "x0"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tang", "[", "x_", "]"}], ":=", 
       RowBox[{"y0", "+", 
        RowBox[{"m", " ", 
         RowBox[{"(", 
          RowBox[{"x", "-", "x0"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"f", "[", "x", "]"}], ",", 
