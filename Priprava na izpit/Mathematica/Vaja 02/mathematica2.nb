     RowBox[{"(", 
      RowBox[{"x", "+", "1"}], ")"}]}], ">", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"3", "-", 
      RowBox[{"2", " ", "x"}]}], "]"}]}], ",", "x", ",", "Reals"}], 
