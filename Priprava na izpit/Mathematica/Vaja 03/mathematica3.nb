Cell[TextData[{
 "Doka\[ZHacek]i, da za poljubni ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]],ExpressionUUID->
  "b6a64e8e-6ae3-4c73-a621-aedc16e1fcbc"],
 " matriki ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "c9d43088-d6bc-43f9-a8cd-b0dacde79cf1"],
 " in ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],ExpressionUUID->
  "092f4e7e-e132-4273-8d6d-f68f1d0a2a08"],
 " velja enakost  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"A", " ", "B"}], ")"}], 
     RowBox[{"-", "1"}]], "=", 
    RowBox[{
     SuperscriptBox["B", 
      RowBox[{"-", "1"}]], 
     SuperscriptBox["A", 
      RowBox[{"-", "1"}]]}]}], TraditionalForm]],ExpressionUUID->
  "6a2c7ae8-0141-4387-964b-211aca7f25f6"],
 "."
}], "Text",
 CellChangeTimes->{{3.943507672012562*^9, 3.9435078221864443`*^9}, {
  3.943507890774477*^9, 
  3.943507917238467*^9}},ExpressionUUID->"f1b2534e-a115-4628-a458-\
a13a315ef4e1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f", ",", "g", ",", "h",
      ",", "A", ",", "B"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "b"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "d"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"B", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"e", ",", "f"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"g", ",", "h"}], "}"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Det", "[", "A", "]"}], "!=", "0"}], "&&", 
    RowBox[{
     RowBox[{"Det", "[", "B", "]"}], "!=", "0"}]}], ",", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Inverse", "[", 
      RowBox[{"A", ".", "B"}], "]"}], "==", 
     RowBox[{
      RowBox[{"Inverse", "[", "B", "]"}], ".", 
      RowBox[{"Inverse", "[", "A", "]"}]}]}], "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9796523728002167`*^9, 
  3.979652416030918*^9}},ExpressionUUID->"e44793bf-cf72-3544-b79a-\
35cc10f6bb85"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Subsection"],
 ". naloga:"
}], "Subsection",
 CellChangeTimes->{{3.784103750645109*^9, 3.784103756660742*^9}, {
  3.909139628475746*^9, 
  3.9091396390546637`*^9}},ExpressionUUID->"789078df-9975-4b9d-9de1-\
20a55a51574f"],

Cell[TextData[{
 "1. Dana je matrika  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "=", 
    RowBox[{"(", GridBox[{
       {"9", "2", 
        RowBox[{"-", "3"}]},
       {"3", "2", "1"},
       {"6", "4", 
        RowBox[{"-", "1"}]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "2f615f79-9c97-4dfe-a677-3198c8ebb3d3"],
 ".  Zapi\[SHacek]i jo kot spremenljivko.\n2. Izra\[CHacek]unaj njeno \
determinanto.\n3. Izra\[CHacek]unaj njene lastne vrednosti.\n4. \
Izra\[CHacek]unaj njene lastne vektorje.\n5. Ali je matrika diagonalizabilna?\
\n6. Matriko \[ZHacek]elimo diagonalizirati. Konstruiraj diagonalno matriko \
(po diagonali ima lastne vrednosti), prehodno matriko (za stolpce ima lastne \
vektorje) in inverz prehodne matrike.\n7. Preveri, ali velja pogoj za \
diagonalizabilnost."
}], "Text",
 CellChangeTimes->{{3.943507672012562*^9, 
  3.9435078221864443`*^9}},ExpressionUUID->"7c86d38c-85a9-455d-a0ac-\
30aa8e1854c6"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"M", ",", "vals", ",", "vecs", ",", "P", ",", "D", ",", "Pinv"}],
      "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"M", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"9", ",", "2", ",", 
         RowBox[{"-", "3"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"6", ",", "4", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"Det", "[", "M", "]"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"vals", "=", 
    RowBox[{"Eigenvalues", "[", "M", "]"}]}], "\n", 
   RowBox[{"vecs", "=", 
    RowBox[{"Eigenvectors", "[", "M", "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "preveri", " ", "linearno", " ", "neodvisnost", " ", "lastnih", " ", 
     "vektorjev"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"MatrixRank", "[", 
    RowBox[{"Transpose", "[", "vecs", "]"}], "]"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"P", "=", 
     RowBox[{"Transpose", "[", "vecs", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"D", "=", 
     RowBox[{"DiagonalMatrix", "[", "vals", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Pinv", "=", 
     RowBox[{"Inverse", "[", "P", "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"M", "==", 
     RowBox[{"P", ".", "D", ".", "Pinv"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.979651840420124*^9, 3.979651844494066*^9}, {
  3.9796524454343185`*^9, 
  3.9796524467626286`*^9}},ExpressionUUID->"b41e5d43-cce5-0246-bbee-\
44e921eec514"]
