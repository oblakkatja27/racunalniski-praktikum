Cell[TextData[{
 "S funkcijo ",
 StyleBox["Solve", "Code"],
 " re\[SHacek]ujemo ena\[CHacek]be. Najbolj enostavno jo uporabimo, kadar \
imamo opravka z eno samo spremenljivko:\n- Poi\[SHacek]\[CHacek]ite vsa \
kompleksna \[SHacek]tevila, ki zado\[SHacek]\[CHacek]ajo ena\[CHacek]bi  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["z", "_"], "=", 
    SuperscriptBox["z", "2"]}], TraditionalForm]],ExpressionUUID->
  "16fb757d-6a61-44d9-b741-eff20664ede5"],
 ". Za konjugiranje lahko uporabite ",
 StyleBox["*", "Code"],
 ", funkcijo Conjugate ali pa znak ",
 StyleBox["Esc",
  FontWeight->"Bold"],
 " co ",
 StyleBox["Esc",
  FontWeight->"Bold"],
 ".\n- Dolo\[CHacek]ite vrednost parametra ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "5dd645a2-e849-45a7-adaf-975d90167957"],
 " v ena\[CHacek]bi ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"2", "a", " ", "x"}], "+", 
      RowBox[{"3", "a"}]}], 
     RowBox[{
      RowBox[{"3", "a"}], " ", "+", " ", 
      RowBox[{"5", "x"}]}]], "=", 
    FractionBox[
     RowBox[{
      RowBox[{"3", "a"}], "-", "4"}], 
     RowBox[{
      RowBox[{"3", "a"}], " ", "-", " ", 
      RowBox[{"5", "x"}]}]]}], TraditionalForm]],ExpressionUUID->
  "e80d2aec-87f6-496d-bdf5-1283411019c9"],
 ", da bo  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "2"}], TraditionalForm]],ExpressionUUID->
  "1fbd2f97-93c3-4559-826c-5deb9c96f42b"],
 "  re\[SHacek]itev ena\[CHacek]be."
}], "Text",
 CellChangeTimes->{{3.942732103391829*^9, 3.942732143692503*^9}, {
   3.942732200528261*^9, 3.9427322063475943`*^9}, 3.943444903717244*^9, {
   3.943444997414136*^9, 
   3.943445023272797*^9}},ExpressionUUID->"db09552c-ccf7-4243-b4bb-\
49d9a01883d1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"z", "\[Conjugate]"}], "==", 
     RowBox[{"z", "^", "2"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"x", "=", "2"}], "\[IndentingNewLine]", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "*", "a", "*", "x"}], "+", 
          RowBox[{"3", "*", "a"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", "*", "a"}], "+", 
          RowBox[{"5", "*", "x"}]}], ")"}]}], ")"}], "==", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", "*", "a"}], "-", "4"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", "*", "a"}], "-", 
          RowBox[{"5", "*", "x"}]}], ")"}]}], ")"}]}], ",", "a"}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.97842988373324*^9, 3.9784300304853897`*^9}, {
  3.978430795893715*^9, 3.9784307964550858`*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"57894c7c-eef9-5a4d-8e9a-b6e22c349f1a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"z", "\[Rule]", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"z", "\[Rule]", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"z", "\[Rule]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], "-", 
      FractionBox[
       RowBox[{"\[ImaginaryI]", " ", 
        SqrtBox["3"]}], "2"]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"z", "\[Rule]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], "+", 
      FractionBox[
       RowBox[{"\[ImaginaryI]", " ", 
        SqrtBox["3"]}], "2"]}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9784299388982925`*^9, 3.9784300319220276`*^9, 
  3.9784307999810486`*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"718aad24-3b7f-684b-b5a5-ef2641bb65d4"],

