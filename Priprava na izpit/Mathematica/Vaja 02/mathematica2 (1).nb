   RowBox[{"{", 
    RowBox[{"a", "\[Rule]", 
     RowBox[{
      FractionBox["1", "3"], " ", 
      RowBox[{"(", 
       RowBox[{"11", "-", 
        SqrtBox["91"]}], ")"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", "\[Rule]", 
     RowBox[{
      FractionBox["1", "3"], " ", 
